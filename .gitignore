# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# The scraped snapshot. Generated by the pipeline, not source, and not git's job
# to version: re-run `npm run ingest && npm run images && npm run normalize` to
# rebuild it. The hand-written docs in data/ are the exception.
# Leading slash anchors to the repo root, so src/data/ is not caught. The `/*`
# form (rather than a bare directory) is what lets the README be negated back in.
/data/*
!/data/README.md

# Product imagery downloaded by the images stage. Belongs to the snapshot above.
# public/fonts stays committed — those are vendored, licensed source assets.
/public/img/

# Tool caches
.cache/
.vite/
coverage/

# Local environment and machine-local overrides. `*.local` is Vite's convention
# for env files that never leave the machine.
.env
.env.*
!.env.example
*.local
.claude/settings.local.json

# Logs
*.log
npm-debug.log*

# OS and editor cruft
.DS_Store
Thumbs.db
.idea/
*.swp
