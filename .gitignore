# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# The scraped snapshot. The normalized half is tracked: it is the deploy input for
# GitHub Pages, and it is also the only baseline the regression guard has on a fresh
# CI runner (design D4). Rebuild it with `npm run ingest && npm run normalize`.
#
# What stays ignored is the pipeline's own working state — the per-product raw
# records and the ~96 MB HTTP response cache under data/raw/, plus the run reports.
# Leading slash anchors to the repo root, so src/data/ is not caught.
/data/raw/
/data/reports/

# Tool caches
.cache/
.vite/
coverage/

# Local environment and machine-local overrides. `*.local` is Vite's convention
# for env files that never leave the machine.
.env
.env.*
!.env.example
*.local
.claude/settings.local.json

# Logs
*.log
npm-debug.log*

# OS and editor cruft
.DS_Store
Thumbs.db
.idea/
*.swp
