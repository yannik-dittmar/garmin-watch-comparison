# Rebuilt inside the image
node_modules
dist
*.tsbuildinfo

# Runtime state, not build input: the snapshot and its ~96 MB response cache reach
# the container through the compose volume, so sending them to the daemon would
# dominate the build context for nothing.
data

# Not part of the application
.git
.gitignore
.claude
openspec
Dockerfile
.dockerignore
compose.yaml
