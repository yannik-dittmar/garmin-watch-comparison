# Rebuilt inside the image
node_modules
dist
*.tsbuildinfo

# Runtime state, not build input: the scraped snapshot, its ~96 MB response cache
# and the downloaded imagery. The container produces these on first start and the
# compose volumes keep them; sending them to the daemon would dominate the build
# context. Neither is in git either.
data
public/img

# Not part of the application
.git
.gitignore
.claude
openspec
Dockerfile
.dockerignore
compose.yaml
